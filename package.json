{
  "name": "cordyceps",
  "version": "0.0.1-alpha.3",
  "description": "Mock model providers and declarative injection for consumer-owned AI harness tests",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.13",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    }
  },
  "files": [
    "dist",
    "harnesses",
    "README.md",
    "assets/cordyceps-256.png",
    "docs/acp-consumers.md",
    "docs/provider-codecs.md",
    "docs/registry.md",
    "docs/testing-apps.md",
    "docs/scenarios.md",
    "docs/verification.md",
    "docs/real-acp.md",
    "docs/real-cli.md",
    "docs/real-frontend.md",
    "docs/real-editor-agents.md",
    "docs/real-provider-agents.md",
    "docs/real-google-agents.md",
    "docs/native-harnesses.md",
    "docs/real-gated-agents.md",
    "docs/real-plandex.md",
    "docs/real-auggie.md",
    "docs/real-q.md",
    "docs/additional-harnesses.md",
    "docs/real-local-agents.md",
    "docs/real-pi-agents.md",
    "docs/real-extra-cli.md",
    "docs/real-codebuff-polygraph.md",
    "docs/real-source-agents.md",
    "docs/real-source-codebuddy-qoder.md",
    "docs/real-vendor-agents.md",
    "docs/real-source-opencode-mimo-dsh.md",
    "docs/ci.md",
    "docs/releases.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "test": "bun test tests",
    "test:package": "node scripts/verify-package.mjs",
    "test:node": "bun scripts/verify-core-node.ts",
    "test:real-acp": "node examples/real-acp/verify.mjs",
    "test:real-cli": "node examples/real-cli/run.mjs",
    "test:inherited-environment": "node examples/inherited-environment/verify-packed.mjs",
    "test:real-frontend": "node examples/real-frontend/verify-packed.mjs",
    "test:real": "npm run test:real-cli && npm run test:real-acp && npm run test:real-frontend",
    "test:real-editors": "node examples/real-editor-agents/verify.mjs",
    "test:real-providers": "node examples/real-provider-agents/run.mjs",
    "test:real-google": "node examples/real-google-agents/run.mjs",
    "test:real-antigravity": "node examples/real-gated-agents/run.mjs /tmp/cordyceps-antigravity.json --antigravity",
    "test:real-q": "node examples/real-q/run.mjs",
    "test:real-auggie": "node examples/real-auggie/verify.mjs",
    "test:real-plandex": "node examples/real-plandex/run.mjs",
    "test:real-rovo": "node examples/real-gated-agents/run.mjs /tmp/cordyceps-rovo.json --rovo",
    "test:real-amp": "node examples/real-gated-agents/run.mjs /tmp/cordyceps-amp.json --amp",
    "test:real-local": "node examples/real-local-agents/run.mjs",
    "test:real-pi": "node examples/real-pi-agents/run.mjs",
    "test:real-extra": "node examples/real-extra-cli/run.mjs",
    "test:real-vendors": "node examples/real-vendor-agents/run.mjs",
    "test:real-freebuff": "node examples/real-source-agents/freebuff/run.mjs",
    "test:real-source-clis": "node examples/real-source-agents/opencode-mimo-dsh/run.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.3.13",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "ajv": "8.17.1"
  }
}
